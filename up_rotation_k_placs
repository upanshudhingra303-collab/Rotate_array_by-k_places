#include<iostream>
 using namespace std;
 int  main(){
      int n =5;
     int arr[n]={1,2,3,4,5};
       int k=arr[0];
      int p;
      cout<<"Enter no of places"<<endl;
     cin>>p;
     
       for(int i=0;i<p;i++){
            for(int j=1;j<n;j++){
                arr[j-1]=arr[j];
                
            }
           arr[n-1]=k;
           k=arr[0];
       }
      cout<<"Left Rotate by "<<p<<" places"<<endl;
      for(int i=0;i<n;i++){
           cout<<arr[i]<<endl;
      }
 }
